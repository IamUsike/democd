erDiagram
    ALERT ||--o{ ALERT_TRANSACTION : "includes"
    TRANSACTION ||--o{ ALERT_TRANSACTION : "flagged in"

    TRANSACTION {
        bigint transaction_id PK
        string account_id "monitored party — not an FK"
        string payee_id "counterparty — not an FK"
        decimal amount
        string currency
        string type
        datetime timestamp
        string description
        string status
    }

    ALERT {
        bigint alert_id PK
        string rule_type "e.g. AMOUNT_THRESHOLD — no rules table in MVP"
        string account_id "denormalized from triggering txn(s)"
        string status
        string severity
        datetime created_at
        datetime acknowledged_at
        datetime investigating_at
        datetime dismissed_at
        datetime closed_at
        string resolution_notes
    }

    ALERT_TRANSACTION {
        bigint alert_id PK, FK
        bigint transaction_id PK, FK
    }
