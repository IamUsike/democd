# Transaction Simulator — Environment Variables
# Copy this file to .env and adjust values before running locally.
# In Docker / CI inject these directly as environment variables.

# ── HTTP Server ──────────────────────────────────────────────────────────────
SERVER_PORT=8090
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info           # debug | info | warn | error
LOG_FORMAT=json          # json | text (use text for local development)

# ── Target Transaction Monitoring API ─────────────────────────────────────────
# REQUIRED — the simulator will refuse to start without this variable.
# Point this at the ingest endpoint of your Spring Boot monitoring backend.
# Docker example: http://transaction-monitoring-backend:8080/api/v1/transactions
# Local example: http://localhost:8081/api/v1/transactions
TRANSACTION_API_URL=http://localhost:8081/api/v1/transactions

# Per-request HTTP timeout for outbound calls (optional, default 30s)
TRANSACTION_API_TIMEOUT=30s

