erDiagram
    ACCOUNT ||--o{ TRANSACTION : "makes"
    PAYEE ||--o{ TRANSACTION : "receives"
    ACCOUNT ||--o{ ALERT : "triggers"
    RULE ||--o{ ALERT : "generates"
    RULE ||--o{ RULE_PARAMETER : "configured by"
    ALERT ||--o{ ALERT_TRANSACTION : "includes"
    TRANSACTION ||--o{ ALERT_TRANSACTION : "flagged in"
    ALERT ||--o{ ALERT_STATUS_HISTORY : "has"

    ACCOUNT {
        string account_id PK
        string account_name
        datetime created_at
    }

    PAYEE {
        string payee_id PK
        string name
        datetime created_at
    }

    TRANSACTION {
        string transaction_id PK
        string account_id FK
        string payee_id FK
        decimal amount
        string currency
        string type
        datetime timestamp
        string description
        string status
    }

    RULE {
        string rule_id PK
        string name
        string description
        string rule_type
        string severity
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    RULE_PARAMETER {
        string parameter_id PK
        string rule_id FK
        string param_key
        string param_value
    }

    ALERT {
        string alert_id PK
        string rule_id FK
        string account_id FK
        string status
        datetime created_at
        datetime acknowledged_at
        datetime investigating_at
        datetime dismissed_at
        datetime closed_at
        string resolution_notes
    }

    ALERT_TRANSACTION {
        string alert_id PK, FK
        string transaction_id PK, FK
    }

    ALERT_STATUS_HISTORY {
        string history_id PK
        string alert_id FK
        string previous_status
        string new_status
        datetime changed_at
        string notes
    }
