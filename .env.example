# API URL baked into the frontend image at build time.
# Use the host that browsers will call (VM public IP/hostname), not Docker DNS.
# Local default:
VITE_API_BASE_URL=http://localhost:8081
#
# On the Linux VM / Jenkins agent, set before compose build, e.g.:
# VITE_API_BASE_URL=http://10.0.0.12:8081
